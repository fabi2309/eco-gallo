# Puerto donde corre el gateway o servidor local
PORT=8080

# Modo desarrollo (1 = muestra códigos de acceso en pantalla sin necesidad de SMTP real)
ECOGALLO_DEV=1

# Carga de datos de prueba al iniciar si la base de datos está vacía (1 = sí)
ECOGALLO_SEED=1

# Correos con privilegios de administrador (separados por coma)
ECOGALLO_ADMINS=admin@edu.uaa.mx

# Configuración SMTP (opcional para envío de correos reales en producción)
ECOGALLO_SMTP_HOST=smtp.gmail.com
ECOGALLO_SMTP_PORT=587
ECOGALLO_SMTP_USER=
ECOGALLO_SMTP_PASS=
ECOGALLO_SMTP_FROM=ECO-GALLO <contacto@ecogallo.uaa.mx>
# ECOGALLO_SMTP_SSL=1  # Usar 1 para puerto 465 (SMTPS)
