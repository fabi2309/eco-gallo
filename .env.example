# Copia este archivo como .env (en la misma carpeta) y llena lo que necesites: la app lo lee al arrancar.
# Las líneas vacías se ignoran. Nunca subas tu .env al repositorio: contiene contraseñas.
PORT=8080
ECOGALLO_ENV=development
ECOGALLO_DEV=1
ECOGALLO_SEED=1
# Cuenta de administración: el primer correo de ECOGALLO_ADMINS se crea con esta contraseña al arrancar.
# En DEV se restablece a la configurada; en producción no se sobrescribe una existente.
# Para conservar las contraseñas de la tesina usa servidor_movil.bat. En producción usa una propia de 12+ caracteres.
ECOGALLO_ADMINS=admin@edu.uaa.mx
ECOGALLO_ADMIN_PASSWORD=EcoGallo2026
# simulado = pago con tarjeta DE PRUEBA dentro de ECO-GALLO (no se cobra dinero real).
# mercadopago = página real de Mercado Pago (necesita las credenciales de abajo).
PAYMENT_PROVIDER=simulado
ECOGALLO_CONNECT_SIMULATED=0
ECOGALLO_LIVE_PAYMENTS=0
ECOGALLO_AUTH_LIMIT=60
ECOGALLO_BACKUP_ENABLED=1
ECOGALLO_BACKUP_KEEP=7
ECOGALLO_BACKUP_INTERVAL_HOURS=24
ECOGALLO_RECONCILE_ENABLED=1
# Correo para enviar los códigos. Vacío = los códigos aparecen en pantalla (solo desarrollo).
# Con Gmail: ECOGALLO_SMTP_HOST=smtp.gmail.com, tu correo en USER y FROM, y en PASS una
# «contraseña de aplicación» de Google (requiere la verificación en 2 pasos). Llena las cuatro o ninguna.
ECOGALLO_SMTP_HOST=
ECOGALLO_SMTP_PORT=587
ECOGALLO_SMTP_USER=
ECOGALLO_SMTP_PASS=
ECOGALLO_SMTP_FROM=
# SMS para confirmar el celular (pagos con tarjeta). Vacío = en desarrollo el código aparece en pantalla.
# Cuenta en twilio.com: Account SID y Auth Token del panel, y un número de Twilio que envíe SMS (formato +1...).
# Con cuenta de prueba de Twilio solo llegan SMS a números que verifiques en su panel. Llena las tres o ninguna.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Responsable de datos personales (aviso de privacidad). Obligatorio en producción.
ECOGALLO_OPERATOR_NAME=
ECOGALLO_OPERATOR_ADDRESS=
ECOGALLO_PRIVACY_EMAIL=
# Entrar con Microsoft (opcional): app registrada en Entra ID de la UAA. Tenant = GUID, no 'common'.
ECOGALLO_MS_CLIENT_ID=
ECOGALLO_MS_CLIENT_SECRET=
ECOGALLO_MS_TENANT=
# Mercado Pago (PAYMENT_PROVIDER=mercadopago): credenciales de prueba con MERCADOPAGO_TEST=1.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_TEST=1
# Stripe Test opcional: el modo simulado no necesita ninguna clave.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ECOGALLO_CONNECT_SIMULATED=1 solo con DEV y claves Stripe Test.
# Para producción, consulta docs/OPERACION.md. Nunca publiques claves live o .env.
